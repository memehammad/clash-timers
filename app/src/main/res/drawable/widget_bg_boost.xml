<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background while a potion/snack runs: tertiary tint with a soft diagonal glow. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
    <gradient
        android:angle="315"
        android:endColor="@color/w_boost_bg2"
        android:startColor="@color/w_boost_bg"
        android:type="linear" />
</shape>
